[gd_scene format=3]

[ext_resource type="Script" path="res://ui/death_screen.gd" id="1_dscr"]
[ext_resource type="Shader" path="res://ui/shaders/menu_atmosphere_overlay.gdshader" id="2_atmos"]
[ext_resource type="Shader" path="res://ui/shaders/menu_accent_bar.gdshader" id="3_acc"]
[ext_resource type="FontFile" path="res://assets/fonts/RubikDirt-Regular.ttf" id="4_dirt"]
[ext_resource type="FontFile" path="res://assets/fonts/RussoOne-Regular.ttf" id="5_russo"]
[ext_resource type="FontFile" path="res://assets/fonts/Jura-Variable.ttf" id="6_jura"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_death_atmos"]
shader = ExtResource("2_atmos")
shader_parameter/fog_tint = Color(0.28, 0.07, 0.06, 1)
shader_parameter/ember_color = Color(1, 0.34, 0.12, 1)
shader_parameter/scrim_strength = 0.84
shader_parameter/fog_strength = 0.56

[sub_resource type="ShaderMaterial" id="ShaderMaterial_death_acc"]
shader = ExtResource("3_acc")
shader_parameter/base_color = Color(0.76, 0.16, 0.08, 1)
shader_parameter/shimmer_color = Color(1, 0.48, 0.2, 1)

[node name="DeathScreen" type="CanvasLayer"]
process_mode = 3
layer = 20
script = ExtResource("1_dscr")

[node name="RootControl" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="AtmosphereOverlay" type="ColorRect" parent="RootControl"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
material = SubResource("ShaderMaterial_death_atmos")

[node name="DeathCard" type="PanelContainer" parent="RootControl"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -285.0
offset_top = -245.0
offset_right = 285.0
offset_bottom = 245.0
grow_horizontal = 2
grow_vertical = 2

[node name="CardVBox" type="VBoxContainer" parent="RootControl/DeathCard"]
